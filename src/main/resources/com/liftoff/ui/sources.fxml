<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liftoff.ui.SourcesController" styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="selection-header">
            <Button text="%nav.back" onAction="#onBack" styleClass="secondary"/>
            <Label text="%sources.heading" styleClass="screen-heading"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll">
            <VBox fx:id="categories" spacing="10" styleClass="page-content"/>
        </ScrollPane>
    </center>
    <bottom>
        <Label fx:id="linkStatus" styleClass="muted" wrapText="true"/>
    </bottom>
</BorderPane>
