<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liftoff.ui.AsteroidDashController" styleClass="screen, mission-screen, game-screen">
    <top>
        <VBox spacing="8" styleClass="mission-header">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="command-bar">
                <Button text="%nav.missions" onAction="#onMissions" styleClass="secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="stepperHost" alignment="CENTER_RIGHT"/>
            </HBox>
            <HBox alignment="BASELINE_LEFT" spacing="18">
                <Label text="%dash.heading" styleClass="screen-heading" minWidth="-Infinity"/>
                <Label fx:id="subtitle" text="%dash.subtitle" styleClass="sub-heading" wrapText="true" minHeight="-Infinity"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox spacing="18" styleClass="page-content">
            <VBox spacing="10" HBox.hgrow="ALWAYS" minWidth="420">
                <StackPane fx:id="trackHost" VBox.vgrow="ALWAYS" styleClass="game-frame, dash-frame" minHeight="240"/>
                <HBox styleClass="dash-controls">
                    <Button fx:id="leftButton" text="%dash.left" focusTraversable="false" styleClass="secondary"/>
                    <Button fx:id="jumpButton" text="%dash.jump" focusTraversable="false" styleClass="secondary"/>
                    <Button fx:id="duckButton" text="%dash.duck" focusTraversable="false" styleClass="secondary"/>
                    <Button fx:id="rightButton" text="%dash.right" focusTraversable="false" styleClass="secondary"/>
                </HBox>
            </VBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="330" minWidth="290" styleClass="clear-scroll">
            <VBox spacing="12" styleClass="light-card, game-side">
                <Label fx:id="difficulty" styleClass="goal-tag, difficulty-tag"/>
                <Label text="%dash.goalTitle" styleClass="section-title"/>
                <Label text="%dash.goal" styleClass="body-text" wrapText="true" minHeight="-Infinity"/>
                <ProgressBar fx:id="distanceBar" maxWidth="Infinity" progress="0" accessibleText="%dash.goalTitle"/>
                <Label fx:id="distance" styleClass="muted"/>
                <HBox spacing="8">
                    <Label fx:id="shields" styleClass="stat-chip"/>
                    <Label fx:id="stars" styleClass="stat-chip"/>
                </HBox>
                <Label text="%dash.howTitle" styleClass="section-title"/>
                <Label text="%dash.how" styleClass="muted" wrapText="true" minHeight="-Infinity"/>
                <Label text="%game.justForFun" styleClass="muted" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            </ScrollPane>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="action-bar">
            <BorderPane.margin>
                <Insets top="12"/>
            </BorderPane.margin>
            <Button text="%game.restart" onAction="#onRestart" styleClass="secondary"/>
            <Button fx:id="pause" text="%dash.pause" onAction="#onPause" styleClass="secondary"/>
            <CheckBox fx:id="calm" text="%dash.calm"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button id="skip-game" text="%game.skip" onAction="#onSkip" styleClass="secondary"/>
            <Button fx:id="finish" id="finish-game" text="%game.continue" onAction="#onFinish" styleClass="primary" disable="true"/>
        </HBox>
    </bottom>
</BorderPane>
