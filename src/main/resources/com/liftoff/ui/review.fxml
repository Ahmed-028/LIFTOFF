<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liftoff.ui.ReviewController" styleClass="screen, mission-screen">
    <top>
        <VBox spacing="8" styleClass="mission-header">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="command-bar">
                <Button text="%nav.missions" onAction="#onMissions" styleClass="secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="stepperHost" alignment="CENTER_RIGHT"/>
            </HBox>
            <Label text="%review.heading" styleClass="screen-heading" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll">
            <HBox spacing="22" styleClass="page-content">
                <VBox fx:id="selectedParts" spacing="10" prefWidth="460" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="%review.parts" styleClass="section-title"/>
                    <Label text="%review.instructions" wrapText="true" styleClass="muted"/>
                </VBox>
                <VBox fx:id="inspection" spacing="12" prefWidth="540" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="%review.gauges" styleClass="section-title"/>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="action-bar">
            <BorderPane.margin>
                <Insets top="12"/>
            </BorderPane.margin>
            <Button text="%nav.back" onAction="#onBack" styleClass="secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane fx:id="confirmGate" pickOnBounds="true">
                <Button text="%review.confirm" onAction="#onConfirm" styleClass="primary" fx:id="confirm"/>
            </StackPane>
        </HBox>
    </bottom>
</BorderPane>
