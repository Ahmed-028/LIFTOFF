<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liftoff.ui.TitleController"
      alignment="CENTER" spacing="16" styleClass="screen, title-screen">
    <Label fx:id="name" text="%title.name" styleClass="game-title"/>
    <Label fx:id="tagline" text="%title.tagline" styleClass="tagline"/>
    <Label fx:id="note" text="%title.note" styleClass="title-note" wrapText="true"/>
    <StackPane fx:id="artHolder" minHeight="250"/>
    <Button fx:id="start" text="%title.start" onAction="#onStart" defaultButton="true" styleClass="primary, big"/>
    <Button fx:id="replay" id="watch-intro" text="%title.intro" onAction="#onIntro" styleClass="secondary"/>
</VBox>
