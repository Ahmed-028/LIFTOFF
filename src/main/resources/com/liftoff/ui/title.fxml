<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liftoff.ui.TitleController"
      alignment="CENTER" spacing="16" styleClass="screen">
    <Label text="%title.name" styleClass="game-title"/>
    <Label text="%title.tagline" styleClass="tagline"/>
    <StackPane fx:id="artHolder" minHeight="320"/>
    <Button text="%title.start" onAction="#onStart" defaultButton="true" styleClass="primary, big"/>
</VBox>
