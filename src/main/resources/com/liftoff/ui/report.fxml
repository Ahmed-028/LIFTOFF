<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liftoff.ui.ReportController" styleClass="screen, mission-screen">
    <top>
        <VBox spacing="8" styleClass="mission-header">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="command-bar">
                <Button text="%nav.missions" onAction="#onMissions" styleClass="secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="stepperHost" alignment="CENTER_RIGHT"/>
            </HBox>
            <Label text="%report.heading" styleClass="screen-heading" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll">
            <VBox spacing="18" styleClass="page-content">
                <VBox spacing="10" styleClass="panel, score-panel">
                    <Label fx:id="result" styleClass="eyebrow"/>
                    <Label fx:id="score" styleClass="score"/>
                    <Label fx:id="totals" wrapText="true" styleClass="body-text"/>
                </VBox>
                <HBox spacing="18">
                    <VBox fx:id="worked" prefWidth="360" HBox.hgrow="ALWAYS" styleClass="report-card, worked">
                        <Label fx:id="workedTitle" text="%report.worked" styleClass="section-title"/>
                    </VBox>
                    <VBox prefWidth="360" HBox.hgrow="ALWAYS" styleClass="report-card, broke">
                        <Label fx:id="brokeTitle" text="%report.broke" styleClass="section-title"/>
                        <Label fx:id="broke" wrapText="true" styleClass="body-text"/>
                    </VBox>
                    <VBox prefWidth="360" HBox.hgrow="ALWAYS" styleClass="report-card, try">
                        <Label fx:id="tryTitle" text="%report.try" styleClass="section-title"/>
                        <Label fx:id="next" wrapText="true" styleClass="body-text"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="14" styleClass="action-bar">
            <BorderPane.margin>
                <Insets top="12"/>
            </BorderPane.margin>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="ending" id="watch-ending" text="%report.ending" onAction="#onEnding"
                    styleClass="secondary, ending-button" visible="false" managed="false"/>
            <Label text="%report.nextHint" styleClass="action-hint"/>
            <Button text="%report.redesign" onAction="#onRedesign" styleClass="primary" />
        </HBox>
    </bottom>
</BorderPane>
