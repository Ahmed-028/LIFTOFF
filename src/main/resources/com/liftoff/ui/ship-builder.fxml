<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liftoff.ui.ShipBuilderController" styleClass="screen, mission-screen, ship-screen">
    <top>
        <VBox spacing="8" styleClass="mission-header">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="command-bar">
                <Button text="%nav.missions" onAction="#onMissions" styleClass="secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="stepperHost" alignment="CENTER_RIGHT"/>
            </HBox>
            <HBox alignment="BASELINE_LEFT" spacing="18">
                <Label text="%ship.heading" styleClass="screen-heading" minWidth="-Infinity"/>
                <Label text="%ship.subtitle" styleClass="sub-heading" wrapText="true"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <BorderPane styleClass="builder">
            <left>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="190" minWidth="170" styleClass="clear-scroll">
                    <VBox prefWidth="186" styleClass="builder-tabs">
                        <StackPane fx:id="tabsHost"/>
                    </VBox>
                </ScrollPane>
            </left>
            <center>
                <StackPane fx:id="hangarHost" minHeight="150" minWidth="240" styleClass="hangar-frame">
                    <Label fx:id="hangarHint" text="%ship.hint" mouseTransparent="true" StackPane.alignment="TOP_LEFT" styleClass="hangar-hint"/>
                </StackPane>
            </center>
            <right>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="300" minWidth="240" styleClass="inspection-scroll">
                    <VBox fx:id="inspection" spacing="12" styleClass="panel"/>
                    <BorderPane.margin>
                        <Insets left="14"/>
                    </BorderPane.margin>
                </ScrollPane>
            </right>
            <bottom>
                <VBox styleClass="parts-dock">
                    <StackPane fx:id="gaugesHost"/>
                    <StackPane fx:id="partsHost"/>
                </VBox>
            </bottom>
        </BorderPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="action-bar">
            <BorderPane.margin>
                <Insets top="12"/>
            </BorderPane.margin>
            <Button text="%nav.back" onAction="#onBack" styleClass="secondary"/>
            <CheckBox fx:id="calmMode" text="%ship.calm"/>
            <Label fx:id="buildStatus" wrapText="true" maxWidth="420" styleClass="builder-status"/>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane fx:id="confirmGate" pickOnBounds="true">
                <Button fx:id="confirm" text="%review.confirm" onAction="#onConfirm" styleClass="secondary"/>
            </StackPane>
            <StackPane fx:id="suppliesGate" pickOnBounds="true">
                <Button text="%ship.continue" onAction="#onNext" styleClass="primary" fx:id="supplies"/>
            </StackPane>
        </HBox>
    </bottom>
</BorderPane>
