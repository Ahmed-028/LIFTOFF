<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liftoff.ui.LaunchController" styleClass="screen, mission-screen">
    <top>
        <VBox spacing="8" styleClass="mission-header">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="command-bar">
                <Button text="%nav.missions" onAction="#onMissions" styleClass="secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="stepperHost" alignment="CENTER_RIGHT"/>
            </HBox>
            <Label text="%launch.heading" styleClass="screen-heading" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <TabPane id="launch-views" tabClosingPolicy="UNAVAILABLE" styleClass="supplies-tabs">
            <Tab text="%cockpit.pad">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll">
            <HBox spacing="22" styleClass="page-content">
                <StackPane fx:id="rocketArt" minWidth="300" prefWidth="560" minHeight="290" HBox.hgrow="ALWAYS" styleClass="launch-pad"/>
                <VBox fx:id="issues" spacing="14" prefWidth="420" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="%launch.intro" wrapText="true" styleClass="muted"/>
                    <Label fx:id="status" wrapText="true" styleClass="status-text"/>
                    <Label fx:id="countdown" styleClass="countdown"/>
                </VBox>
            </HBox>
        </ScrollPane>
            </Tab>
            <Tab fx:id="cabinTab" text="%cockpit.tab"/>
        </TabPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="action-bar">
            <BorderPane.margin>
                <Insets top="12"/>
            </BorderPane.margin>
            <Button text="%nav.back" onAction="#onBack" styleClass="secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%launch.check" onAction="#onCheck" styleClass="primary" fx:id="check"/>
        </HBox>
    </bottom>
</BorderPane>
