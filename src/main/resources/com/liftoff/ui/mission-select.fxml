<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liftoff.ui.MissionSelectController" styleClass="screen, selection-screen">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="selection-header">
            <Button text="%nav.back" onAction="#onBack" styleClass="secondary"/>
            <Label text="%select.heading" styleClass="screen-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button id="open-sources" text="%select.sources" onAction="#onSources" styleClass="secondary"/>
            <StackPane fx:id="soundHost"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clear-scroll">
            <VBox spacing="20" styleClass="selection-content">
                <Label text="%select.intro" styleClass="intro-text" wrapText="true"/>
                <HBox fx:id="mainMissions" spacing="22" fillHeight="true"/>
                <TitledPane text="%select.extra" expanded="false" animated="false">
                    <HBox fx:id="extraMissions" spacing="18" styleClass="extra-missions"/>
                </TitledPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
